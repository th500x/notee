# Copy to .env and adjust. XAMPP MariaDB defaults:
PORT=3003
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=06_rental_tracking

# JWT must match main site when using admin APIs
# JWT_SECRET=...

# Local ONLY: skip JWT on admin routes + treat list as admin (see .env.local.example)
# RENTAL_TRACKING_DEV_SKIP_JWT=1

# Aliyun OSS (optional for local; without keys the server still starts, upload API returns 503)
# OSS_REGION=oss-cn-heyuan
# OSS_BUCKET=06-rental-tracking
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
