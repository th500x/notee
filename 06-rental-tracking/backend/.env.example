# 服务器配置
PORT=3003
NODE_ENV=development

# 全局管理员密码
GLOBAL_ADMIN_PASSWORD=notee.vip.2026

# MySQL数据库配置
DB_HOST=localhost
DB_USER=notee_rental
DB_PASSWORD=your_database_password
DB_NAME=notee_rental_tracking

# 阿里云OSS配置
# ⚠️ 重要：不要提交真实的AccessKey到Git！
# 请复制此文件为 .env 并填入真实的Key
OSS_REGION=oss-cn-heyuan
OSS_BUCKET=06-rental-tracking
OSS_ACCESS_KEY_ID=your_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_access_key_secret_here

# OSS域名配置（可选）
# 如果绑定了自定义域名，填写这里
# OSS_CUSTOM_DOMAIN=https://cdn.notee.vip
