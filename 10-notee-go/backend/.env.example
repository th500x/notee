# Copy to backend/.env on each environment.
# Local: DB_USER=root, DB_PASSWORD empty, then npm run db:migrate
# Production 宝塔: create empty DB first, set MIGRATION_ASSUME_DB_EXISTS=1, then migrate

PORT=3010
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=10_notee_go

# Required (>=16 chars). Independent secret — do NOT reuse 3000 admin token or 05 JWT.
JWT_SECRET=change-me-one-line-local-dev-secret

# Optional JWT TTL (default 30 days)
# PLAYER_TOKEN_TTL_SECONDS=2592000

# Set to 1 to skip node-cron daily TTL/board jobs (tests)
# DISABLE_CRON=1

# Production (宝塔 · 与 05/11 同机)
# DB_NAME=10_notee_go
# DB_USER=notee.vip.22
# DB_PASSWORD=<宝塔生成的密码>
# MIGRATION_ASSUME_DB_EXISTS=1
# NODE_ENV=production
# JWT_SECRET=<strong random secret>

# Cloud Translation (docs/04 §2.5). API key restricted to this host's IP and the Translation API.
# Never commit the real key. Without it, /translate answers 503 and the app shows the original.
# GOOGLE_TRANSLATE_API_KEY=

# Private square-crop JPEGs (owner JWT only). Default: 10-notee-go/data/pour-media
# POUR_MEDIA_DIR=/www/wwwroot/notee/10-notee-go/data/pour-media
