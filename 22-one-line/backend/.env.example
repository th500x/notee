# Copy to backend/.env on each environment.
# Local: DB_USER=root, DB_PASSWORD empty, then npm run db:migrate
# Production 宝塔: create empty DB first, set MIGRATION_ASSUME_DB_EXISTS=1, then migrate

PORT=3022
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=22_one_line

# Required (>=16 chars). Independent secret — do NOT reuse 3001 admin token or 05 JWT.
JWT_SECRET=change-me-one-line-local-dev-secret

# Optional JWT TTL (default 30 days)
# PLAYER_TOKEN_TTL_SECONDS=2592000

# Set to 1 to skip node-cron daily TTL/board jobs (tests)
# DISABLE_CRON=1

# Production (宝塔 · 与 05/11 同机)
# DB_NAME=22_one_line
# DB_USER=notee.vip.22
# DB_PASSWORD=<宝塔生成的密码>
# MIGRATION_ASSUME_DB_EXISTS=1
# NODE_ENV=production
# JWT_SECRET=<strong random secret>

# Private square-crop JPEGs (owner JWT only). Default: 22-one-line/data/pour-media
# POUR_MEDIA_DIR=/www/wwwroot/notee/22-one-line/data/pour-media
