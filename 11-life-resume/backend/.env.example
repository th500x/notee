# Copy to backend/.env on each environment.
# Local XAMPP: DB_USER=root, DB_PASSWORD empty, npm run db:migrate (no MIGRATION_ASSUME_DB_EXISTS).
# Production 宝塔: see block below; then MIGRATION_ASSUME_DB_EXISTS=1 && npm run db:migrate

PORT=3011
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=11_life_resume

# Must match 05-san-storm backend JWT_SECRET (required in production)
JWT_SECRET=

# 账号表在 05_san_storm.accounts。本地默认与上面 DB_* 同一 MySQL 用户。
# 生产若 11 库用户无权读 05 库：填写 05 的库账号，或给 11 用户授权
# GRANT SELECT, INSERT, UPDATE ON 05_san_storm.accounts TO 'notee.vip.11'@'localhost';
SAN_STORM_DB_NAME=05_san_storm
# SAN_STORM_DB_HOST=127.0.0.1
# SAN_STORM_DB_PORT=3306
# SAN_STORM_DB_USER=
# SAN_STORM_DB_PASSWORD=

# Local ONLY: skip JWT startup check (do not use in production)
# JWT_DEV_BYPASS=1

# --- Production (宝塔 · 与 05/06 同机) ---
# DB_NAME=11_life_resume
# DB_USER=notee.vip.11
# DB_PASSWORD=<宝塔生成的密码>
# MIGRATION_ASSUME_DB_EXISTS=1
# NODE_ENV=production
# JWT_SECRET=<与 05 生产 .env 相同>

# Aliyun OSS (P6+; server starts without keys)
# Bucket 名称即 11-life-resume；对象键由程序自动生成
# 浏览器直传须在 OSS 控制台配置 CORS，或运行：node scripts/configure-oss-cors.js
OSS_REGION=oss-cn-heyuan
OSS_BUCKET=11-life-resume
# OSS_CORS_ORIGINS=https://notee.vip,http://localhost:5177
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# --- 人生轨迹 lifePath（P12 · 阿里通义 DashScope）---
# 控制台申请：https://dashscope.console.aliyun.com/
# 勿提交真实 Key；本地复制到 backend/.env
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-turbo
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LIFE_PATH_COOLDOWN_HOURS=24
# LIFE_PATH_MAX_ENTRIES=80
# LIFE_PATH_BODY_MAX_CHARS=400
# LIFE_PATH_AI_TIMEOUT_MS=90000

# --- ETH 15m 均线 Web Push（07 订阅；npm run vapid:generate）---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://notee.vip
# 可选：逗号分隔 4 位账号；空 = 凡登录并授权的账号
# ETH_MA_PUSH_ACCOUNT_WHITELIST=
# 阿里云国内机访问币安常被拦：可设 HTTP 代理，或把 REST/WS 指到可达的反代
# BINANCE_HTTPS_PROXY=http://127.0.0.1:7890
# BINANCE_KLINES_URL=https://fapi.binance.com/fapi/v1/klines
# BINANCE_WS_KLINE_URL=wss://fstream.binance.com/ws/ethusdt@kline_15m
