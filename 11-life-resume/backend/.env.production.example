# 生产服务器 backend/.env 模板（复制为 .env.production 或 .env，勿提交真实密码入库）
# 宝塔 MySQL：库名请用 11_life_resume（下划线），与迁移脚本一致；勿用 11-life-resume

NODE_ENV=production
PORT=3011

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=notee.vip.11
DB_PASSWORD=CHANGE_ME
DB_NAME=11_life_resume

# 宝塔已手动建库后，迁移只建表不 CREATE DATABASE
MIGRATION_ASSUME_DB_EXISTS=1

# 须与 05-san-storm 生产 backend/.env 的 JWT_SECRET 完全一致
JWT_SECRET=CHANGE_ME_SAME_AS_05

OSS_REGION=oss-cn-heyuan
OSS_BUCKET=11-life-resume
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
