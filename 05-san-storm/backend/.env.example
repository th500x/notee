# ==================== 数据库（必填） ====================
# 与 backend/database/connection.js 一致
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=05_san_storm

# DATETIME / TIMESTAMP 列的解析时区（CR P3，2026-04-29 修订）
# - 默认 'local'：mysql2 按运行进程的本地时区解析 DB 字符串。
# - 关键约束：mysql2.timezone **必须等于 DB session 的实际时区**，否则读 / 写时区错位（可能偏几小时）。
#   "进程时区 = DB session 时区"在同机 XAMPP / 同容器栈天然成立 → 本地与生产都不需要单独配置。
# - 极端场景（DB 与 server 故意分时区 / 跨机部署）才显式覆盖；值可写 '+08:00' / 'Z'(UTC) / '+07:00' 等。
# DB_TIMEZONE=local

# ==================== 鉴权（必填） ====================
# 玩家会话 JWT 签名密钥；至少 16 字符。生成示例：
#   openssl rand -hex 32
# 缺失或过短，server.js 启动期会主动 process.exit(1)，禁止使用默认密钥。
JWT_SECRET=

# 主站（3001）管理员 global JWT 验签密钥；与 notee/backend 的 JWT_SECRET 一致（>=16 字符）。
# 生产必填，否则 /api/admin/* 与 /api/auth/users 等管理端点无法验主站令牌。
GLOBAL_JWT_SECRET=

# 玩家会话 token 有效期（秒）；缺省 30 天（2592000）。与前端 PLAYER_TOKEN_DURATION_MS 对齐。
PLAYER_TOKEN_TTL_SECONDS=2592000

# 仅本地开发期老 localStorage（无 token）兜底；填 1 启用，留空 / 任意其它值禁用。
# 生效条件：NODE_ENV !== 'production' 且本变量 === '1'；满足时 requireAuth 缺失 token 会从
# URL :playerId / query.playerId / body.playerId / body.attackerId / body.defenderId 推断身份。
# 同时跳过 server.js 的 JWT_SECRET 启动检查；生产环境下永远忽略此 flag。
# JWT_DEV_BYPASS=1

# 仅本地管理页调试：NODE_ENV !== 'production' 且 === '1' 时 /api/admin/* 可无 token 访问。
# 与前端首页「开发环境 bypass」配合；生产永远忽略。
# ADMIN_DEV_BYPASS=1

# ==================== CORS ====================
# 生产白名单（逗号分隔）；为空时使用本地默认（localhost:5173/3002/3004 等）。
# 例：CORS_ALLOWED_ORIGINS=https://notee.vip,https://san-storm.notee.vip
CORS_ALLOWED_ORIGINS=

# ==================== 注册防刷 ====================
# 同一浏览器指纹冷却小时数；0=关闭，720=30 天（默认）。
REGISTER_MACHINE_COOLDOWN_HOURS=720

# ==================== 战斗纪念图 OSS ====================
# OSS 缺失时 POST /api/memorial/battle 返回 502；本地开发可留空。
OSS_REGION=oss-cn-heyuan
OSS_BUCKET=05-san-storm
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 自定义域名 / CDN 根 URL；为空时使用 https://{bucket}.{region}.aliyuncs.com/{key}
# OSS_PUBLIC_BASE_URL=https://cdn.example.com

# ==================== 定时任务 ====================
# 临时表清理 / 排名快照清理走 node-cron；生产建议 Asia/Shanghai。
# CRON_TZ=Asia/Shanghai
