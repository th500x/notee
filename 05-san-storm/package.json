{
  "name": "san-storm",
  "version": "1.0.0",
  "private": true,
  "description": "真三风云 - 三国策略战棋游戏（npm workspaces 根）",
  "workspaces": [
    "game",
    "wiki",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:wiki": "npm run dev -w san-storm-wiki",
    "dev:game": "npm run dev -w san-storm-game",
    "dev:backend": "npm run dev -w san-storm-backend",
    "build:wiki": "npm run build -w san-storm-wiki",
    "build:game": "npm run build -w san-storm-game",
    "build:vps": "npm run build:vps -w san-storm-game",
    "build:all": "npm run build:wiki && npm run build:game",
    "init:db": "npm run init-db -w san-storm-backend",
    "test:automated": "node scripts/run-automated-checks.cjs",
    "test:automated:quick": "node scripts/run-automated-checks.cjs --quick --no-backend"
  },
  "keywords": [
    "game",
    "strategy",
    "three-kingdoms",
    "workspaces"
  ],
  "author": "Notee.vip",
  "license": "UNLICENSED"
}
